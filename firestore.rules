rules_version = '2';

// 우리 반 담벼락 - Firestore 보안 규칙
//
// roles/{uid} 문서로 "선생님"과 "학생"을 구분합니다.
//   - roles/{uid} 문서가 있고 role 필드가 "teacher"면 선생님입니다.
//   - 문서가 없으면 학생입니다.
//   - roles 문서는 클라이언트에서 만들 수 없습니다. 선생님 계정은
//     Firebase 콘솔 > Firestore Database에서 관리자가 직접
//     roles/<선생님 uid> 문서를 { role: "teacher" }로 만들어야 합니다.
//
// 권한 정리
//   - 선생님: 모든 메모를 읽고, 쓰고, 지울 수 있습니다.
//   - 학생: 담벼락을 읽을 수 있고, 자기 uid로 메모를 새로 쓸 수 있습니다.
//           (자기 메모라도) 수정·삭제는 할 수 없습니다.
//
// 이 파일은 참고용입니다. 실제 적용은 Firebase 콘솔의
// Firestore Database > 규칙 탭에 이 내용을 붙여넣고 "게시"를 눌러야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher';
    }

    // 역할 정보. 본인 역할 확인용으로 읽기만 허용하고, 쓰기는 콘솔에서만 합니다.
    match /roles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow list: if isTeacher();
      allow write: if false;
    }

    match /memos/{memoId} {
      allow read: if true;

      // 로그인한 사용자만 쓸 수 있고, 자기 uid로만 저장할 수 있습니다.
      // (선생님도 메모를 쓸 때는 자기 uid로 씁니다.)
      // app.js의 5글자 제한과 동일하게, 서버 쪽에서도 한 번 더 검사합니다.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.createdAt is number;

      // 수정·삭제는 선생님만 할 수 있습니다. 학생은 자기 메모도 고치거나 지울 수 없습니다.
      allow update, delete: if isTeacher();
    }
  }
}
